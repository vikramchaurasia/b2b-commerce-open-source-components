<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <isExposed>true</isExposed>
  <apiVersion>67</apiVersion>
  <masterLabel>Renegotiate or Decline Quote</masterLabel>
  <description>Lets buyers renegotiate or decline a quote on the quote details page.</description>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property name="quoteId" type="String" default="{!QuoteDetail.id}" label="Quote ID" description="The ID of the quote"></property>
      <property name="quoteStatus" type="String" default="{!QuoteDetail.status}" label="Quote Status" description="The current status of the quote" translatable="true"></property>
      <property name="hasLineItems" type="String" default="{!QuoteDetail.hasLineItems}" label="Has Line Items" description="Whether the quote has line items from QuoteDetail"></property>
      <property name="buttonText" type="String" default="Renegotiate or Decline" label="Button Text" translatable="true"></property>
      <property name="variant" type="String" default="secondary" label="Button Style" datasource="java://siteforce.customComponent.datasource.ButtonStyleDataSource"></property>
      <property name="size" type="String" default="standard" label="Button Size" datasource="java://siteforce.customComponent.datasource.ButtonSizeDataSource"></property>
      <property name="width" type="String" default="stretch" label="Max Button Width" datasource="java://siteforce.customComponent.datasource.ButtonStretchDataSource"></property>
      <property name="headerText" type="String" default="Renegotiate or decline quote?" label="Title" translatable="true"></property>
      <property name="subheadingText" type="String" default="Request a revised quote for a better offer, or decline this quote." label="Subheading" translatable="true"></property>
      <property name="notesPlaceholder" type="String" default="Describe the modifications you need or your reason for declining..." label="Notes Placeholder" translatable="true"></property>
      <property name="declineButtonLabel" type="String" default="Decline" label="Button Text" translatable="true"></property>
      <property name="renegotiateButtonLabel" type="String" default="Renegotiate" label="Button Text" translatable="true"></property>
      <designLayout>
        <designSection name="Action Button">
          <designLayoutItems>
            <designLayoutProperty name="quoteId" cbVisibleIf="quoteId=false"></designLayoutProperty>
            <designLayoutProperty name="quoteStatus" cbVisibleIf="quoteStatus=false"></designLayoutProperty>
            <designLayoutProperty name="hasLineItems" cbVisibleIf="hasLineItems=false"></designLayoutProperty>
            <designLayoutProperty name="buttonText"></designLayoutProperty>
            <designLayoutProperty name="variant"></designLayoutProperty>
            <designLayoutProperty name="size"></designLayoutProperty>
            <designLayoutProperty name="width"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Title">
          <designLayoutItems>
            <designLayoutProperty name="headerText"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Subheading">
          <designLayoutItems>
            <designLayoutProperty name="subheadingText"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Description Placeholder">
          <designLayoutItems>
            <designLayoutProperty name="notesPlaceholder"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Decline Button">
          <designLayoutItems>
            <designLayoutProperty name="declineButtonLabel"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Renegotiate Button">
          <designLayoutItems>
            <designLayoutProperty name="renegotiateButtonLabel"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>