<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>67</apiVersion>
  <isExposed>true</isExposed>
  <masterLabel>Cart Lock</masterLabel>
  <description>Shows a banner on a shared cart while another user is checking out. For use on the cart list and cart detail
        pages.</description>
  <capabilities>
    <capability>lightning__ServerRenderableWithHydration</capability>
  </capabilities>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property name="cartSummary" label="Cart Details Expression" type="String" default="{!Cart.Details}"></property>
      <property name="alignItems" label="Icon and Text Alignment" type="String" default="start" datasource="start,center,end"></property>
      <property name="backgroundColor" label="Background Color" type="Color" default="#FFF2E5"></property>
      <property name="borderColor" label="Border Color" type="Color"></property>
      <property name="borderRadius" label="Border Radius" type="Integer" min="0" max="50" default="8"></property>
      <property name="iconColor" label="Icon Color" type="Color" default="#EAB24B"></property>
      <designLayout>
        <designSection>
          <designLayoutItems>
            <designLayoutProperty name="cartSummary"></designLayoutProperty>
            <designLayoutProperty name="alignItems"></designLayoutProperty>
            <designLayoutProperty name="iconColor"></designLayoutProperty>
            <designLayoutProperty name="backgroundColor"></designLayoutProperty>
            <designLayoutProperty name="borderColor"></designLayoutProperty>
            <designLayoutProperty name="borderRadius"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>