<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <masterLabel>Create Cart Button</masterLabel>
  <description>Shows a button to create a new cart.</description>
  <apiVersion>67</apiVersion>
  <isExposed>true</isExposed>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property name="newCartButtonLabel" label="New Cart Button Label" type="String" default="New Cart" translatable="true"></property>
      <property name="cartNameLabel" label="Cart Name Field Label" type="String" default="Cart Name" translatable="true"></property>
      <property name="cartDescriptionLabel" label="Cart Description Field Label" type="String" default="Description" translatable="true"></property>
      <property name="showImportSection" label="Show Import Section" type="Boolean" default="true" description="Show the Import File section in the New Cart modal. Buyers can upload a file to import cart items."></property>
      <property name="importModalSubtitleLabel" label="Import File Title" type="String" default="Import using CSV (Optional)" translatable="true"></property>
      <property name="importUploadFileLabel" label="Upload File Button Label" type="String" default="Upload File to Import" translatable="true"></property>
      <property name="importDropFileLabel" label="Drag &amp;amp; Drop File Label" type="String" default="or drop file" translatable="true"></property>
      <property name="importMappingTitleLabel" label="Mapping Title" type="String" default="Cart Item Identifiers" translatable="true"></property>
      <property name="importCreateWithoutImportLabel" label="Create Without Import Button Label" type="String" default="Create Without Import" translatable="true"></property>
      <property name="importFinishAndCreateLabel" label="Finish &amp;amp; Create Button Label" type="String" default="Create and Import" translatable="true"></property>
      <property name="variant" label="Button Variant" type="String" default="primary" datasource="java://siteforce.customComponent.datasource.ButtonStyleDataSource"></property>
      <property name="size" label="Button Size" type="String" default="standard" datasource="java://siteforce.customComponent.datasource.ButtonSizeDataSource"></property>
      <property name="width" label="Max Button Width" type="String" default="stretch" datasource="java://siteforce.customComponent.datasource.ButtonStretchDataSource"></property>
      <property name="buttonTextColor" label="Button Text Color" type="Color"></property>
      <property name="buttonTextHoverColor" label="Button Text Hover Color" type="Color"></property>
      <property name="buttonBackgroundColor" label="Button Background Color" type="Color"></property>
      <property name="buttonBackgroundHoverColor" label="Button Background Hover Color" type="Color"></property>
      <property name="buttonBorderColor" label="Button Border Color" type="Color"></property>
      <designLayout>
        <designSection>
          <designLayoutItems>
            <designLayoutProperty name="newCartButtonLabel"></designLayoutProperty>
            <designLayoutProperty name="cartNameLabel"></designLayoutProperty>
            <designLayoutProperty name="cartDescriptionLabel"></designLayoutProperty>
            <designLayoutProperty name="buttonTextColor"></designLayoutProperty>
            <designLayoutProperty name="buttonTextHoverColor"></designLayoutProperty>
            <designLayoutProperty name="buttonBackgroundColor"></designLayoutProperty>
            <designLayoutProperty name="buttonBackgroundHoverColor"></designLayoutProperty>
            <designLayoutProperty name="buttonBorderColor"></designLayoutProperty>
            <designLayoutProperty name="variant"></designLayoutProperty>
            <designLayoutProperty name="size"></designLayoutProperty>
            <designLayoutProperty name="width"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Import File">
          <designLayoutItems>
            <designLayoutProperty name="showImportSection"></designLayoutProperty>
            <designLayoutProperty name="importModalSubtitleLabel" cbVisibleIf="showImportSection=true"></designLayoutProperty>
            <designLayoutProperty name="importUploadFileLabel" cbVisibleIf="showImportSection=true"></designLayoutProperty>
            <designLayoutProperty name="importDropFileLabel" cbVisibleIf="showImportSection=true"></designLayoutProperty>
            <designLayoutProperty name="importMappingTitleLabel" cbVisibleIf="showImportSection=true"></designLayoutProperty>
            <designLayoutProperty name="importCreateWithoutImportLabel" cbVisibleIf="showImportSection=true"></designLayoutProperty>
            <designLayoutProperty name="importFinishAndCreateLabel" cbVisibleIf="showImportSection=true"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>