{
    "presets": [
        {
            "view": {
                "definition": "site:cartListView",
                "type": "component",
                "children": [
                    {
                        "name": "sortDropdown",
                        "title": "Sort Dropdown",
                        "type": "region",
                        "children": [
                            {
                                "definition": "site:cartListSortDropdown",
                                "type": "component",
                                "attributes": {
                                    "defaultSortOrder": "Default"
                                }
                            }
                        ]
                    },
                    {
                        "name": "emptyListView",
                        "title": "emptyListView",
                        "type": "region",
                        "children": [
                            {
                                "definition": "dxp_base:textBlock",
                                "type": "component",
                                "attributes": {
                                    "text": "When you create carts, you'll see them here.",
                                    "textDisplayInfo": "{\"headingTag\": \"h3\", \"textStyle\": \"heading-medium\"}",
                                    "textDecoration": "{\"bold\": true}",
                                    "textAlign": "center"
                                }
                            }
                        ]
                    },
                    {
                        "name": "cartsRepeater",
                        "title": "cartsRepeater",
                        "type": "region",
                        "children": [
                            {
                                "definition": "dxp_content_layout:list",
                                "type": "component",
                                "children": [
                                    {
                                        "name": "sfdcRepeaterItem",
                                        "title": "Repeater",
                                        "type": "region",
                                        "children": [
                                            {
                                                "definition": "site:cartDetailsCardV2",
                                                "type": "component",
                                                "attributes": {
                                                    "cartSummaryData": "{!CartSummary}"
                                                },
                                                "children": [
                                                    {
                                                        "name": "cartLock",
                                                        "title": "Cart Lock",
                                                        "type": "region",
                                                        "children": [
                                                            {
                                                                "definition": "site:cartLockBanner",
                                                                "type": "component",
                                                                "attributes": {
                                                                    "cartSummary": "{!CartSummary}",
                                                                    "alignItems": "center"
                                                                },
                                                                "children": [
                                                                    {
                                                                        "name": "message",
                                                                        "type": "region",
                                                                        "children": [
                                                                            {
                                                                                "definition": "dxp_base:textBlock",
                                                                                "type": "component",
                                                                                "attributes": {
                                                                                    "text": "Checkout in progress.",
                                                                                    "textAlign": "left",
                                                                                    "textDisplayInfo": "{\"textStyle\": \"body-regular\", \"headingTag\": \"p\"}"
                                                                                }
                                                                            }
                                                                        ]
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "name": "requestQuote",
                                                        "title": "Request Quote",
                                                        "type": "region",
                                                        "children": [
                                                            {
                                                                "definition": "commerce_builder:requestQuoteButton",
                                                                "type": "component",
                                                                "attributes": {
                                                                    "cartSummaryData": "{!CartSummary}"
                                                                }
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "name": "cartOptions",
                                                        "title": "Cart Options",
                                                        "type": "region",
                                                        "children": [
                                                            {
                                                                "definition": "commerce_builder:cartOptions",
                                                                "type": "component",
                                                                "attributes": {
                                                                    "cartData": "{!CartSummary}"
                                                                }
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "name": "defaultPill",
                                                        "title": "Default Cart Tag",
                                                        "type": "region",
                                                        "children": [
                                                            {
                                                                "definition": "site:commonPillBuilder",
                                                                "type": "component",
                                                                "attributes": {
                                                                    "labelText": "Default"
                                                                }
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "name": "cartAsyncStateView",
                                                        "title": "Cart Async State View",
                                                        "type": "region",
                                                        "children": [
                                                            {
                                                                "definition": "site:cartAsyncStateView",
                                                                "type": "component",
                                                                "attributes": {
                                                                    "cartData": "{!CartSummary}"
                                                                }
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ],
                                "attributes": {
                                    "itemSpacing": "large",
                                    "listType": "unformatted",
                                    "showPagination": true,
                                    "autoScrollToMostRecent": true
                                },
                                "dataProviders": [
                                    {
                                        "definition": "sfdc_cms__commerceCartListDataProvider",
                                        "sfdcExpressionKey": "CartSummary",
                                        "attributes": {
                                            "collaborationFilter": "MyCarts",
                                            "pageSize": 10
                                        },
                                        "type": "dataProvider"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
